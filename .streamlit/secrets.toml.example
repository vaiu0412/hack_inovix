# Optional AI keys. Ripple works without them (rule-based mode).
#
# Local:  copy this file to .streamlit/secrets.toml (it is git-ignored) and paste your key.
# Cloud:  Streamlit Community Cloud -> your app -> Settings -> Secrets -> paste the same lines.
#
# Free Groq key: https://console.groq.com/keys  (Whisper speech-to-text + Llama reasoning)
GROQ_API_KEY = "paste-your-groq-key-here"

# Or Google Gemini instead:
# GEMINI_API_KEY = "paste-your-gemini-key-here"
