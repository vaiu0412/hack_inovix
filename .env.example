# DEPORT environment settings. Everything is optional – the app works with none of them (demo mode).
# Copy to .env (git-ignored – never commit real keys). docker compose reads .env automatically; on Render /
# Railway add the same names in the service's Environment settings. The same names also work in
# .streamlit/secrets.toml (see .streamlit/secrets.toml.example).

# ---------------------------------------------------------------- Storage
# Database file. Put it on a persistent disk when hosting; voice notes and backups go next to it.
# Default without this: data/deport.db in the project folder. The Docker image sets /data/deport.db.
DB_PATH=/data/deport.db

# ---------------------------------------------------------------- AI (voice + reasoning) – optional
# GROQ_API_KEY=paste-your-groq-key-here
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_WHISPER_MODEL=whisper-large-v3
# GEMINI_API_KEY=paste-your-gemini-key-here
# GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- OTP by email (SMTP) – optional
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=paste-your-16-letter-app-password
# SMTP_FROM=DEPORT <you@gmail.com>

# ---------------------------------------------------------------- AI voice call for orders nobody accepts – optional
# Without these the partner app shows a simulated call (Demo mode). Setup: docs/AI_CALL.md
# TWILIO_ACCOUNT_SID=paste-your-account-sid
# TWILIO_AUTH_TOKEN=paste-your-auth-token
# TWILIO_FROM_NUMBER=+15551234567
# PUBLIC_BASE_URL=https://your-api.example.com     (where Twilio reaches the API; an ngrok URL when testing)
# CALL_LANGUAGE=en-IN
# CALL_VOICE=Polly.Aditi                            (optional Twilio voice)
# Exotel / Plivo: adapters are stubs for now (they fall back to Demo mode)
# EXOTEL_SID=paste-your-exotel-sid
# EXOTEL_TOKEN=paste-your-exotel-token
# PLIVO_AUTH_ID=paste-your-plivo-id
# PLIVO_AUTH_TOKEN=paste-your-plivo-token
# The API moves offers along every 20 s even when no page is open: on (default) | off
# ESCALATION_SCHEDULER=on
# The API retrains the acceptance model once a day when new decisions came in: on (default) | off
# LEARNING_SCHEDULER=on

# ---------------------------------------------------------------- Live data – optional
# OpenWeatherMap (free key): live weather every 10 min; heavy rain opens a "Weather risk" alert.
# Without it the weather is set by hand on Command Center.
# OWM_API_KEY=paste-your-openweathermap-key
# TomTom Traffic Flow (free key): traffic on the branch's roads every 10 min; jams become suggestions to confirm.
# Without it "Check traffic (demo)" plays a scripted jam on Trichy Road.
# TOMTOM_API_KEY=paste-your-tomtom-key
# The API runs the live feeds every minute even when no page is open: on (default) | off
# FEEDS_SCHEDULER=on

# ---------------------------------------------------------------- Demo
# true = one-click "Quick demo access" chips on the sign-in page. Keep off in production.
# DEMO_MODE=true
# 1 = no network calls at all (no LLM, no OSRM) – used by the tests.
# RIPPLE_OFFLINE=1
