# DEPORT secrets. Everything here is optional. Copy this file to .streamlit/secrets.toml
# (git-ignored – never commit real keys). On Streamlit Cloud: App -> Settings -> Secrets.
# Any of these can also be set as environment variables (same names).
# The database file location is an environment variable only: DB_PATH (see .env.example).
# PostgreSQL instead of the SQLite file (tables are created automatically):
# DATABASE_URL = "postgresql://user:password@host:5432/deport"

# ---------------------------------------------------------------- AI (voice + reasoning)
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY = "paste-your-groq-key-here"
# GEMINI_API_KEY = "paste-your-gemini-key-here"
# Photo reports use the same keys (Gemini first, else Groq vision). Without a key the partner picks the type.
# GROQ_VISION_MODEL = "meta-llama/llama-4-scout-17b-16e-instruct"

# ---------------------------------------------------------------- Quick demo access (judges)
# "true" shows one-click chips under the sign-in form (Branch Admin, Delivery Partner DP102) and a
# Super Admin chip on /console. Off by default – leave it off in production.
# DEMO_MODE = "true"

# ---------------------------------------------------------------- AI voice call for orders nobody accepts
# Twilio Voice. Without it the partner app shows a simulated call (Demo mode). Setup: docs/AI_CALL.md
# TWILIO_ACCOUNT_SID = "paste-your-account-sid"
# TWILIO_AUTH_TOKEN = "paste-your-auth-token"
# TWILIO_FROM_NUMBER = "+15551234567"
# PUBLIC_BASE_URL = "https://your-api.example.com"
# CALL_LANGUAGE = "en-IN"

# ---------------------------------------------------------------- Live data (weather, traffic)
# OWM_API_KEY = "paste-your-openweathermap-key"
# TOMTOM_API_KEY = "paste-your-tomtom-key"

# ---------------------------------------------------------------- Customers (tracking link, WhatsApp)
# Tracking links are <PUBLIC_APP_URL>/track?code=…
# PUBLIC_APP_URL = "https://your-app.example.com"
# WhatsApp for customer updates and delivery codes; without it messages stay drafts (Demo mode).
# Twilio WhatsApp (with the Twilio keys above) …
# TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"
# … or the WhatsApp Business Cloud API:
# WHATSAPP_TOKEN = "paste-your-whatsapp-cloud-token"
# WHATSAPP_PHONE_ID = "paste-your-phone-number-id"

# ---------------------------------------------------------------- Mobile API (JWT, push)
# JWT_SECRET = "paste-a-long-random-string-here"
# FCM_PROJECT_ID = "your-firebase-project-id"
# FCM_SERVICE_ACCOUNT = '''{ "type": "service_account", ... }'''

# ---------------------------------------------------------------- OTP by email (SMTP)
# Gmail: turn on 2-Step Verification, create an App password (Google Account -> Security -> App passwords).
# Without email or SMS set up, codes appear on screen (labelled DEMO) only when DEMO_MODE or OTP_DEMO is "true".
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_USER = "you@gmail.com"
# SMTP_PASSWORD = "paste-your-16-letter-app-password"
# SMTP_FROM = "DEPORT <you@gmail.com>"

# ---------------------------------------------------------------- OTP by SMS (Twilio) – staff and customers
# Uses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN above plus one of these. Setup: docs/CUSTOMERS.md
# TWILIO_VERIFY_SID = "VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_SMS_FROM = "+15551234567"
# SMS_DEFAULT_COUNTRY = "91"
# OTP_DEMO = "true"      (a demo without email/SMS: show codes on screen)

# ---------------------------------------------------------------- Google sign-in (OIDC via st.login, needs Authlib)
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application).
# Authorised redirect URI: <your app URL>/oauth2callback, e.g. http://localhost:8501/oauth2callback
# Only emails of ACTIVE DEPORT accounts can sign in; accounts are never auto-created.
# Until this is filled in, the Google button is hidden.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "paste-a-long-random-string-here"
#
# [auth.google]
# client_id = "paste-your-client-id.apps.googleusercontent.com"
# client_secret = "paste-your-client-secret-here"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
