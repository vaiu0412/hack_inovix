# Ripple secrets. Everything here is optional: without it Ripple runs in demo mode
# (rule-based AI, demo SMS codes on screen, labelled demo Google chooser).
#
# Local:  copy this file to .streamlit/secrets.toml (it is git-ignored) and fill in values.
# Cloud:  Streamlit Community Cloud -> your app -> Settings -> Secrets -> paste the same lines.

# ---------------------------------------------------------------- AI
# Free Groq key: https://console.groq.com/keys  (Whisper speech-to-text + LLM reasoning)
GROQ_API_KEY = "paste-your-groq-key-here"
# Or Google Gemini instead:
# GEMINI_API_KEY = "paste-your-gemini-key-here"

# ---------------------------------------------------------------- sign-in
# "1" (default): Google button opens a labelled demo chooser and OTP codes are shown on screen.
# "0": hide the demo chooser (the Google button then needs the [auth] section below).
DEMO_MODE = "1"

# When an SMS provider key is set, OTP codes are no longer shown on screen (wire the provider in
# modules/auth.py -> request_otp).
# SMS_API_KEY = "paste-your-sms-provider-key-here"

# Team name in the sign-in page footer (default "Team Ripple")
# TEAM_NAME = "Team Ripple"

# ---------------------------------------------------------------- Google sign-in (OIDC via st.login)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URI: <your app URL>/oauth2callback, e.g. http://localhost:8501/oauth2callback
# Only emails that already belong to an ACTIVE Ripple account can sign in; no account is auto-created.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "paste-a-long-random-string-here"
#
# [auth.google]
# client_id = "paste-your-client-id.apps.googleusercontent.com"
# client_secret = "paste-your-client-secret-here"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
