# DEPORT secrets. Everything here is optional: without it DEPORT runs in demo mode
# (rule-based AI, OTP codes shown on screen labelled DEMO, Google button disabled).
#
# Local:  copy this file to .streamlit/secrets.toml (it is git-ignored) and fill in values.
# Cloud:  Streamlit Community Cloud -> your app -> Settings -> Secrets -> paste the same lines.
# Never commit real keys.

# ---------------------------------------------------------------- AI
# Free Groq key: https://console.groq.com/keys  (Whisper speech-to-text + LLM reasoning)
GROQ_API_KEY = "paste-your-groq-key-here"
# Or Google Gemini instead:
# GEMINI_API_KEY = "paste-your-gemini-key-here"

# ---------------------------------------------------------------- OTP by SMS
# When an SMS provider key is set, OTP codes are no longer shown on screen (wire the provider in
# modules/auth.py -> request_otp). Without it the code appears in a toast labelled DEMO.
# SMS_API_KEY = "paste-your-sms-provider-key-here"

# Team name in the sign-in page footer (default "Team DEPORT")
# TEAM_NAME = "Team DEPORT"

# ---------------------------------------------------------------- Google sign-in (OIDC via st.login)
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application).
# Authorised redirect URI: <your app URL>/oauth2callback, e.g. http://localhost:8501/oauth2callback
# Only emails that already belong to an ACTIVE DEPORT account can sign in; no account is auto-created.
# Until this is filled in, the "Continue with Google" button stays disabled ("Google sign-in not set up").
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "paste-a-long-random-string-here"
#
# [auth.google]
# client_id = "paste-your-client-id.apps.googleusercontent.com"
# client_secret = "paste-your-client-secret-here"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
